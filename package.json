{
  "name": "dsh-netease-float",
  "version": "2.0.0",
  "description": "Full-page NetEase Cloud Music player for DeepSeek Harness: player page, lyrics, playlists, search, account settings. 网易云音乐整页播放器插件。",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "netease",
    "music",
    "player",
    "lyrics"
  ],
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  }
}
